<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background_light" />

    <!-- Main Logo - 35% from top (approx 250dp for most devices) -->
    <item
        android:width="125dp" 
        android:height="72dp"
        android:gravity="center_horizontal|top"
        android:top="250dp">
        <bitmap android:src="@drawable/welcome_logo" />
    </item>

    <!-- Branding Logo - 92% from top (approx 650dp for most devices) -->
    <item
        android:width="97dp"
        android:height="24dp"
        android:gravity="center_horizontal|bottom"
        android:bottom="100dp">
        <bitmap android:src="@drawable/logo_branding" />
    </item>
</layer-list>
