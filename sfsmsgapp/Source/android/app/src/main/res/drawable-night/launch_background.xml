<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />
    
    <!-- Main Logo (light version for dark mode) -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/welcome_logo_light" />
    </item>
    
    <!-- Branding Logo at bottom (light version for dark mode) -->
    <item android:top="80%">
        <bitmap
            android:gravity="center"
            android:src="@drawable/logo_branding_light" />
    </item>
</layer-list>
